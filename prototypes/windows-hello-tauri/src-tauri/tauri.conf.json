{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokalite Windows Hello Prototype",
  "version": "0.1.0",
  "identifier": "dev.lokalite.prototype.windows-hello",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lokalite Windows Hello Prototype",
        "width": 720,
        "height": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
